# OmniShop AI — environment (copy to .env; a dev-default .env is committed so
# `docker compose up` works out of the box — CHANGE APP_SECRET for anything real).

# --- Security ---
APP_SECRET=dev-only-change-me-please-32bytes-minimum

# --- Datastores (overridden by docker-compose for the containers) ---
PG_DSN=postgresql://omni_app:omni_app@localhost:5432/omnishop
PG_DSN_ADMIN=postgresql://omni:omni@localhost:5432/omnishop
REDIS_URL=redis://localhost:6379/0

# --- LLM (ADR-007). Env is only the *fallback* default; providers are also
# configurable in-app: platform admin sets a default, tenants can override
# (Anthropic / OpenAI / Gemini / vLLM-local), if the admin allows it. ---
# LLM_PROVIDER: auto | stub | anthropic   (auto = anthropic if ANTHROPIC_API_KEY set, else stub)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=1024
# effort for the interactive support path: low keeps replies fast/cheap (see ADR-007).
LLM_EFFORT=low

# --- Embeddings. Default is a local, key-free, deterministic embedder (384 dims). ---
# EMBEDDING_PROVIDER: local | openai
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384

# --- OCR (flexible/swappable). tesseract | vlm | disabled. Also settable in-app. ---
OCR_PROVIDER=tesseract
OCR_MODEL=

# --- Meta (Facebook/Instagram) platform app — for real Messenger/IG channels. ---
# The SaaS owns ONE Facebook App (needs Meta App Review for pages_messaging).
# Set these THREE (App ID/Secret + a public callback base) once, as the deployer,
# and every tenant can then self-serve: click "Kết nối Facebook", authorise, pick a
# Page — no admin action per tenant. App ID/Secret can also be set in-app under
# Quản trị → Facebook App instead of here.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=omnishop-verify
# Public https base that Facebook redirects back to, e.g. https://app.yourdomain.com
OAUTH_REDIRECT_BASE=

# --- Sign-in & platform staff ---------------------------------------------------
# Google Sign-In (OAuth). Can also be set in-app (Quản trị → Đăng nhập Google).
# Register the redirect URI in Google Cloud: <OAUTH_REDIRECT_BASE>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The deployer's platform admin login — created/promoted on startup if absent.
# THIS is how the operator knows the admin username/password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Google emails auto-promoted to platform admin on first sign-in (comma list).
PLATFORM_ADMIN_EMAILS=

# --- Self-serve, no admin intervention ------------------------------------------
# allow_tenant_llm defaults ON, so a tenant can paste their OWN Gemini/OpenAI key
# under Cài đặt → AI and go live. Combined with the Meta vars above, a merchant runs
# the full real flow (real Facebook Page + real Gemini key) end-to-end themselves.

# --- Cost estimation ($/1M tokens) used for per-tenant COGS in usage metering. ---
COST_INPUT_PER_M=5.0
COST_OUTPUT_PER_M=25.0
COST_EMBEDDING_PER_M=0.02
