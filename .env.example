# OmniShop AI — environment
#
# Almost everything an operator configures now lives in the Admin UI
# (Quản trị hệ thống → Cấu hình), stored in the database and changeable
# without a redeploy: LLM / Embedding / OCR, Facebook App, Google Sign-In,
# Payment, Email (alerts), Public domain (webhooks + OAuth redirects), the
# token-saving "ignore stale messages" window, plans and cost rates.
# Do NOT put those here — set them in the app.
#
# This file holds only what must exist BEFORE the app/UI can run.

# --- Security (REQUIRED — change for anything real) ---
APP_SECRET=dev-only-change-me-please-32bytes-minimum

# --- Datastores (infra; overridden by docker-compose inside containers) ---
PG_DSN=postgresql://omni_app:omni_app@localhost:5432/omnishop
PG_DSN_ADMIN=postgresql://omni:omni@localhost:5432/omnishop
REDIS_URL=redis://localhost:6379/0

# --- Embedding vector size (schema-level: must match the DB vector column) ---
EMBEDDING_DIM=384

# --- CORS: comma-separated allowed web origins, or * for any ---
CORS_ORIGINS=*

# --- First platform admin login (created/promoted on startup if absent) ---
# This is how the operator first signs in; afterwards manage staff in the UI.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional: Google emails auto-promoted to platform admin on first sign-in.
PLATFORM_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# OPTIONAL first-boot fallbacks. Prefer the Admin UI for all of these — they
# are read ONLY when the matching UI config is still empty. Safe to leave blank.
# ---------------------------------------------------------------------------
# Default LLM before any UI config (auto = Anthropic if a key is set, else stub):
# LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5
# Public HTTPS base for webhooks + OAuth redirects
# (better: Quản trị → Vận hành → Tên miền công khai):
# OAUTH_REDIRECT_BASE=https://app.yourdomain.com
