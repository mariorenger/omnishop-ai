# OmniShop AI — committed dev defaults so `docker compose up` works out of the
# box. CHANGE APP_SECRET for anything real. All operational config (LLM, email,
# Facebook App, Google, payment, public domain, cost rates…) is set in the
# Admin UI (Quản trị hệ thống → Cấu hình), not here.

# --- Security ---
APP_SECRET=dev-only-change-me-please-32bytes-minimum

# --- Datastores (overridden by docker-compose for the containers) ---
PG_DSN=postgresql://omni_app:omni_app@localhost:5432/omnishop
PG_DSN_ADMIN=postgresql://omni:omni@localhost:5432/omnishop
REDIS_URL=redis://localhost:6379/0

# --- Embedding vector size (must match the DB vector column) ---
EMBEDDING_DIM=384

# --- CORS ---
CORS_ORIGINS=*
