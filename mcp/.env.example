# IBM ContextForge (MCP Gateway) — secrets & knobs for docker-compose.mcp.yml.
# Copy the lines you need into the root .env (Compose reads it for ${...}),
# or keep this as mcp/.env and pass: --env-file mcp/.env
# Every value has a dev-only default in the compose file: CHANGE THEM for anything real.

# Image tag — pin a release for reproducible deploys (e.g. 1.0.10).
CONTEXTFORGE_VERSION=latest

# Secrets (32+ random chars each: `openssl rand -hex 32`)
CF_JWT_SECRET_KEY=
CF_AUTH_ENCRYPTION_SECRET=
CF_POSTGRES_PASSWORD=

# Admin UI login (http://localhost:4444/admin)
CF_ADMIN_EMAIL=admin@example.com
CF_ADMIN_PASSWORD=
CF_DEFAULT_USER_PASSWORD=

# Public URL clients use to reach the gateway (behind HTTPS in production)
CF_PUBLIC_URL=http://localhost:4444
CF_PORT=4444
CF_WORKERS=2
CF_LOG_LEVEL=INFO
# Production: CF_ENVIRONMENT=production, CF_SECURE_COOKIES=true, CF_FORCE_PASSWORD_CHANGE=true
CF_ENVIRONMENT=development
CF_SECURE_COOKIES=false
CF_FORCE_PASSWORD_CHANGE=false

# OmniShop account the MCP server acts as (a real merchant member in production)
OMNISHOP_MCP_EMAIL=demo@omnishop.local
OMNISHOP_MCP_PASSWORD=demo12345
# Empty = that user's first organization
OMNISHOP_MCP_ORG_ID=
# true adds `reply_to_conversation` (sends real messages to customers!)
OMNISHOP_MCP_ALLOW_WRITE=false
