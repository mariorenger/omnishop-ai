%
\definecolor{frametitlebg}{HTML}{14284b}
\definecolor{framesubtitlebg}{HTML}{ce1628}

% color palettes
\setbeamercolor{palette primary}{fg=hustnavy}
\setbeamercolor{palette secondary}{fg=hustred}
% Title page, part, section, subsection
\setbeamercolor{titlelike}{fg=white}
\setbeamercolor{title}{fg=hustnavy}
\setbeamercolor{subtitle}{fg=hustred}
\setbeamercolor{partname}{fg=hustnavy}
%% table of contents
\setbeamercolor{section in toc}{fg=hustnavy}
\setbeamercolor{subsection in toc}{fg=hustblack}
\setbeamercolor{section number projected}{fg=white,bg=hustred}
\setbeamercolor{subsection number projected}{fg=white,bg=hustnavy}
\setbeamercolor{subsubsection number projected}{fg=white,bg=hustnavy}
\setbeamercolor{item}{fg=hustred,bg=hustnavy}
\setbeamercolor{item projected}{fg=white,bg=hustred}
%% Figures and table
\setbeamercolor{caption}{fg=hustblack}
\setbeamercolor{caption name}{fg=hustred}
%% Elements of a frame
\setbeamercolor{framesubtitle}{bg=hustred,fg=white}
\setbeamercolor{frametitle}{bg=hustnavy,fg=white}
\setbeamercolor{page number in head/foot}{bg=hustred,fg=white}
%% Blocks
\setbeamercolor{block title}{fg=hustnavy}
\setbeamercolor{block title alerted}{fg=hustred}
\setbeamercolor{block title example}{fg=hustnavy}

\mode<all>
