\mode<presentation>
\ProvidesPackage{beamercolorthemehust}[HUST color theme]
%
% Bản phối màu xanh than (navy) + đỏ.
%  * Xanh than: màu chủ đạo (thanh tiêu đề, tiêu đề trang bìa, tiêu đề block).
%  * Đỏ: màu nhấn (số trang, phụ đề, dấu đầu dòng, khẩu hiệu trang bìa).
% Giữ nguyên tên các màu cũ (hustred*, hustyellow*, hustblack*) để không làm hỏng chỗ nào đang dùng chúng.

% 9 is the original one, the others are alphas)
\definecolor{hustyellow}{HTML}{f3c108}
